<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SB.Feature.FileManager</RootNamespace>
    <AssemblyName>SB.Feature.FileManager</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>SB.Feature.FileManager</PackageId>
    <Version>0.1.0</Version>
    <Description>SB Feature 服务器文件管理器 —— 浏览 / 文本编辑 / 新建 / 重命名 / 删除 / 上传 / 下载 / chmod。与已有 web shell 权限对等，带审计日志。</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- 只依赖 Core + Models（与 BackupReceive / AccessToken 范式一致）。
         不引 Services、不引 WebApi（避免循环）。控制器 / IFormFile / FileStreamResult
         走官方 framework-reference。 -->
    <ProjectReference Include="..\..\..\sb\sb-framework\SB.Framework.Core\SB.Framework.Core.csproj" />
    <ProjectReference Include="..\..\..\sb\sb-framework\SB.Framework.Models\SB.Framework.Models.csproj" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\sb\sb-framework\SB.Framework.Analyzers\SB.Framework.Analyzers.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
