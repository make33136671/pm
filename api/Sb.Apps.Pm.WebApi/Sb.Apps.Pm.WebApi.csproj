<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Sb.Apps.Pm.WebApi</RootNamespace>
    <AssemblyName>Sb.Apps.Pm.WebApi</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- 与 Sb.Apps.Pm.Services 保持一致：EmitChatModule=true 时恢复 Chat 模块 -->
    <DefineConstants Condition="'$(EmitChatModule)' == 'true'">$(DefineConstants);PM_CHAT_MODULE</DefineConstants>
  </PropertyGroup>

  <!-- Version = 1.0.<git commit 累计数>, sourcelink 自动追加 +sha,
       /admin/App/Info 显示 "1.0.40+0ed40f96..."。
       AssemblyVersion/FileVersion 固定 1.0.0.0 避开 ushort 上限。
       git 命令失败(非 git 仓库 / 没装 git) → 兜底 1.0.0,publish 不会中断。 -->
  <Target Name="SetBuildVersion" BeforeTargets="GetAssemblyVersion;CoreCompile">
    <Exec Command="git rev-list --count HEAD"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          ConsoleToMSBuild="true"
          StandardOutputImportance="Low"
          IgnoreExitCode="true"
          ContinueOnError="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitCommitCount" />
    </Exec>
    <PropertyGroup>
      <GitCommitCount Condition="'$(GitCommitCount)' == ''">0</GitCommitCount>
      <Version>1.0.$(GitCommitCount)</Version>
    </PropertyGroup>
  </Target>
  <PropertyGroup>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <!-- ENABLE_LICENSE_MANAGE / ENABLE_BACKUP_RECEIVE 已废弃：授权管理/备份接收已是独立插件包，
         改为引 SB.Feature.* 包即启用（见下方 PackageReference）。 -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SB.Framework.WebApi" Version="0.5.5" />
    <PackageReference Include="SB.Framework.Core" Version="0.5.0" />
    <PackageReference Include="SB.Framework.Analyzers" Version="0.5.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <!-- 功能插件：引包即启用。
         授权管理（SB.Feature.LicenseManage）已从框架主线移除（见 sb-framework
         AI_Plugin_Architecture 勘误），BaGet 上无此包，PM 代码也未使用，故移除引用。 -->
    <PackageReference Include="SB.Feature.BackupReceive" Version="0.1.2" />
    <PackageReference Include="SB.Feature.AccessToken" Version="0.2.4" />
    <ProjectReference Include="..\Sb.Apps.Pm.Services\Sb.Apps.Pm.Services.csproj" />
  </ItemGroup>

  <!-- Chat 模块暂时移出编译（与 Sb.Apps.Pm.Services 保持同步，见 api/docs/Chat-Module-Disabled.md） -->
  <ItemGroup Condition="'$(EmitChatModule)' != 'true'">
    <Compile Remove="Controllers\Chat\**\*.cs" />
    <Compile Remove="Controllers\Ai\AiPipelineController.cs" />
  </ItemGroup>
</Project>
